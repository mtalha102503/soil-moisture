# Supabase connection for the soil moisture chatbot.
# Copy this file to .env.local and fill in your own values.
# These are read ONLY on the server (API route). Never expose the secret
# key in browser code and never commit a real key to git.

# Project URL (Supabase Dashboard -> Project Settings -> API -> Project URL)
SUPABASE_URL=https://yvsiorgwmqkothidrcbo.supabase.co

# Project SECRET key (Supabase Dashboard -> Project Settings -> API Keys
# -> "Secret keys"). This is the sb_secret_... key, NOT the publishable
# key and NOT an account access token.
SUPABASE_SECRET_KEY=sb_secret_replace-with-your-own-secret-key
